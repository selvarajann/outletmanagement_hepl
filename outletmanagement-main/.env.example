# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/outlet_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=YOUR_DB_PASSWORD

# JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET

# Mailtrap / SMTP Configuration
MAIL_USERNAME=YOUR_MAIL_USERNAME
MAIL_PASSWORD=YOUR_MAIL_PASSWORD

# AI API Keys
SARVAM_API_KEY=YOUR_SARVAM_API_KEY

# Redis Configuration (Production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# Webhook Secrets
IMS_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Firebase
FIREBASE_SERVICE_ACCOUNT_JSON=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON

# IMS
IMS_API_KEY=YOUR_IMS_API_KEY
IMS_ORDERS_API_TOKEN=YOUR_IMS_ORDERS_API_TOKEN
